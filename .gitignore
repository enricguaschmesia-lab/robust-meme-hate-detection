# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
*.egg-info/

# Virtual environments
.venv/
venv/
env/

# Harness / editor / OS
.claude/
.vscode/
.idea/
.DS_Store

# Training outputs / retained build inputs (not part of the delivery)
runs/
demo/out/
cluster-checkpoints/
cluster-results/

# Datasets are not redistributed: drop the Hateful Memes files under data/
# (see data/README.md). Everything under data/ is ignored except the committed
# deterministic train split.
data/**
!data/README.md
!data/processed/
!data/processed/splits/
!data/processed/splits/train_split.json

# Model weights are ignored by default. The two small (~4 MB) frozen-encoder
# demo checkpoints ship in-repo; the large adversarial / combined ones exceed
# GitHub's 100 MB limit and are fetched from a Release on first --live/--prepare.
*.pt
*.pth
*.safetensors
!demo/checkpoints/clean.pt
!demo/checkpoints/naturalistic.pt
