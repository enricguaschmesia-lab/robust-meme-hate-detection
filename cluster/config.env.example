# Project-side cluster configuration template.
# Copy this file to `cluster/config.env` and edit the user-specific values.
# `cluster/config.env` is gitignored so each collaborator keeps their own copy.
#
# Required for cluster.sh-based automation. Not needed if you use the manual
# workflow in scripts/runai_submit_template.sh.

# -- SSH (jumphost) --------------------------------------------------------
# An entry in your ~/.ssh/config for the EPFL jumphost.
SSH_HOST=epfl-jumphost

# -- Identity --------------------------------------------------------------
# Your EPFL username, uid, and group number on the cluster.
REMOTE_USER=<your-epfl-username>
REMOTE_UID=<your-numeric-uid>
REMOTE_GROUP_NUMBER=49

# Your Run:AI project (one per user under the EE-559 course).
RUNAI_PROJECT=course-ee-559-<your-epfl-username>

# -- Paths on the jumphost -------------------------------------------------
REMOTE_HOME=/home/<your-epfl-username>
REMOTE_PROJECT_DIR=/home/<your-epfl-username>/robust-meme-hate-detection

# Group scratch root on the jumphost (NB: trailing -g49). Shared across the team.
REMOTE_SCRATCH_DIR=/mnt/course-ee-559/rcp-caas-ee-559-g49/scratch-g49
REMOTE_SCRATCH_PROJECT_DIR=/mnt/course-ee-559/rcp-caas-ee-559-g49/scratch-g49/robust-meme-hate-detection

# -- PVCs mounted inside Run:AI jobs --------------------------------------
# Scratch PVC is shared across the group; home PVC is per-user.
SCRATCH_PVC=course-ee-559-scratch-g49
SCRATCH_MOUNT=/scratch
HOME_PVC=home
HOME_MOUNT=/home/<your-epfl-username>

# -- Dataset (read-only, staged by course staff) --------------------------
JOB_DATA_ROOT=/scratch/datasets/hate_meta

# -- Per-project paths inside a Run:AI job --------------------------------
JOB_CODE_DIR=/home/<your-epfl-username>/robust-meme-hate-detection
JOB_SCRATCH_ROOT=/scratch/robust-meme-hate-detection
JOB_RESULTS_ROOT=/scratch/robust-meme-hate-detection/experiments

# -- Images ----------------------------------------------------------------
BASE_IMAGE=registry.rcp.epfl.ch/ee559/environment-with-packages:latest

# Either point at a teammate's pushed image (if your registry creds allow it)
# or build/push your own with cluster.sh build-image + push-image.
IMAGE_REPO=registry.rcp.epfl.ch/ee-559-<your-epfl-username>/robust-meme-hate-detection
IMAGE_TAG=v0.2
DEFAULT_IMAGE=$BASE_IMAGE
CUSTOM_IMAGE=$IMAGE_REPO:$IMAGE_TAG

# -- Resources -------------------------------------------------------------
RUNAI_GPU=1

# -- Default configs for the canned submit-* commands ---------------------
# Override per call by passing CONFIG=<path>.
SMOKE_CONFIG=configs/smoke.yaml
TRAIN_CONFIG=configs/stage1.yaml
